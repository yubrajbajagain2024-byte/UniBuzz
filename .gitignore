# dependencies
node_modules/

# next.js
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts

# env files (never commit secrets)
.env
.env.*
!.env.example
apps/web/.env*
!apps/web/.env.example
# The mobile app's .env holds only EXPO_PUBLIC_* values (public anon key, site URL)
!apps/mobile/.env

# supabase local dev
supabase/.branches
supabase/.temp
supabase/.env

# misc
.DS_Store
*.log
*.tsbuildinfo
.vercel

# turborepo
.turbo/

# Stubs `npx expo start` writes at the repo root when it is run from here instead of apps/mobile
# (apps/mobile/CLAUDE.md): they belong to no workspace and must never be committed.
/tsconfig.json
/.expo/

# The staging release rehearsal's state: test accounts and their passwords (supabase/tests/staging/release-rehearsal.mjs)
supabase/tests/staging/.rehearsal.json
# The staging ad-delivery run's kept accounts and their passwords (supabase/tests/staging/ad-delivery.mjs --keep)
supabase/tests/staging/.ad-delivery.json
# CampConnect Admin's staging test accounts, their passwords and authenticator keys (supabase/tests/staging/admin-e2e-accounts.mjs)
supabase/tests/staging/.admin-e2e.json
# The staging campus admin for the portal's campus-admin browser check (supabase/tests/staging/campus-e2e-account.mjs)
supabase/tests/staging/.campus-e2e.json
